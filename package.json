{
  "name": "korea-lingo-bridge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-next-router.cjs",
    "predev": "node scripts/patch-next-router.cjs",
    "prebuild": "node scripts/patch-next-router.cjs",
    "dev": "next dev -p 3005",
    "build": "node scripts/patch-next-router.cjs && next build && node scripts/verify-router-build.cjs",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0",
    "type-check": "tsc --noEmit",
    "test": "node --test --test-isolation=none tests/*.test.cjs",
    "db:types": "node scripts/generate-db-types.cjs",
    "release:check": "node scripts/release-check.cjs",
    "payments:test:check": "node scripts/check-test-payments.cjs",
    "mobile:setup": "node scripts/setup-mobile-env.cjs",
    "mobile:check": "npm --prefix apps/mobile run check",
    "mobile:type-check": "npm --prefix apps/mobile run type-check",
    "mobile:start": "npm --prefix apps/mobile start",
    "mobile:build:android": "npm --prefix apps/mobile run build:preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/react-query": "^5.45.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.400.0",
    "next": "15.5.29",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.52.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^2.3.0",
    "zod": "^3.23.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.29",
    "playwright": "1.56.1",
    "postcss": "^8.4.0",
    "prettier": "3.6.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0"
  }
}
