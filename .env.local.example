# Supabase 프로젝트 설정 (supabase.com 대시보드 > Project Settings > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 서버 전용 — Edge Function/관리자 작업(정산 배치, 결제 웹훅 등)에서만 사용. 브라우저에 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 정식 도메인. 결제 콜백과 메일 링크에 사용합니다.
APP_ORIGIN=https://your-domain.example
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_BUSINESS_REGISTRATION=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=

# 최종 정책 문서를 실제 사업에 맞게 완성한 후에만 true로 전환합니다.
NEXT_PUBLIC_POLICIES_PUBLISHED=false
PAYMENTS_ENABLED=false
# Toss API 개별 연동 키. 테스트/운영 키를 섞지 않습니다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 웹훅 URL: /api/payments/webhook?token=<서버에 설정한 무작위 값>
PAYMENT_WEBHOOK_SECRET=
# 예약·결제 복구·메일 작업: GET /api/jobs/maintenance, Bearer 인증
CRON_SECRET=
# 선택한 메일 공급자의 계정·발신 도메인 검증이 필요합니다.
RESEND_API_KEY=
EMAIL_FROM=

# Expo push: server only. Enable enhanced push security in the Expo dashboard.
PUSH_ENABLED=false
EXPO_PUSH_ACCESS_TOKEN=
EXPO_PUSH_PROJECT_ID=
# Existing maintenance job dispatches pushes too. Alternatively run
# GET /api/jobs/push every minute with Authorization: Bearer <CRON_SECRET>.
