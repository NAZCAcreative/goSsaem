{
  "name": "@gossaem/teacher-mobile",
  "version": "0.1.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "type-check": "tsc --noEmit",
    "check": "node scripts/check-config.cjs",
    "build:preview": "npm run check && eas build --platform android --profile preview",
    "build:development": "npm run check && eas build --platform android --profile development",
    "export:android": "expo export --platform android",
    "version:patch": "node ../../scripts/mobile-version.cjs patch",
    "version:minor": "node ../../scripts/mobile-version.cjs minor"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.2",
    "expo": "58.0.25",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.20",
    "expo-device": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2",
    "eas-cli": "^18.0.0"
  }
}
