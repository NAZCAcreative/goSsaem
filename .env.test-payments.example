# Copy these values into .env.local. Never commit actual keys.
# npm run dev uses port 3005; change APP_ORIGIN if you use a different port.
PAYMENTS_MODE=test
APP_ORIGIN=http://localhost:3005

# Get a matching pair from Toss Developer Center > API keys > API individual integration.
# These are placeholders, not usable API keys. Do not use gck/gsk widget keys.
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_REPLACE_WITH_YOUR_CLIENT_KEY
TOSS_SECRET_KEY=test_sk_REPLACE_WITH_YOUR_SECRET_KEY

# Keep your existing Supabase project settings in .env.local.
# Apply migrations through 0049_test_payments.sql to your test project first.
# NEXT_PUBLIC_SUPABASE_URL=...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...

# Live payments remain disabled while testing.
PAYMENTS_ENABLED=false
NEXT_PUBLIC_POLICIES_PUBLISHED=false
